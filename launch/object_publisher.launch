<launch>
  <arg name="mocap_topic" default="mavros" />
  <arg name="odom_topic" default="local_position/odom" />
  <arg name="pose_topic" default="local_position/pose" />

  <arg name="filter_alpha" default="0.2" />
  <!-- this is the IP address of the windows system publishing the mocap poses -->
  <arg name="server" default="192.168.0.241"/>
  <arg name="asset_name" default="hound2" />
  <arg name="ramp_1" default="ramp1" />
  <arg name="ramp_2" default="ramp2" />
  <arg name="block_1" default="block1" />
  <arg name="block_2" default="block2" />
  <arg name="block_3" default="block3" />
  <arg name="block_4" default="block4" />
  <node pkg="vrpn_client_ros" type="vrpn_client_node" name="vrpn_client_node" output="screen">
    <rosparam subst_value="true">
      server: $(arg server)
      port: 3883

      update_frequency: 360.0
      frame_id: map

      # Use the VRPN server's time, or the client's ROS time.
      use_server_time: false
      broadcast_tf: true

      # Must either specify refresh frequency > 0.0, or a list of trackers to create
      <!-- refresh_tracker_frequency: 1.0 -->
      trackers:
       - $(arg asset_name) # Name of the rigid body asset
       - $(arg ramp_1)
       - $(arg ramp_2)
       - $(arg block_1)
       - $(arg block_2)
       - $(arg block_3)
       - $(arg block_4)

    </rosparam>
  </node>

  <!-- <node pkg="topic_tools" type="relay" name="ramp1_pose_relay" args="/vrpn_client_node/$(arg ramp_1)/pose $(arg ramp_1)/pose" />
  <node pkg="topic_tools" type="relay" name="ramp2_pose_relay" args="/vrpn_client_node/$(arg ramp_2)/pose $(arg ramp_2)/pose" />
  <node pkg="topic_tools" type="relay" name="block1_pose_relay" args="/vrpn_client_node/$(arg block_1)/pose $(arg block_1)/pose" />
  <node pkg="topic_tools" type="relay" name="block2_pose_relay" args="/vrpn_client_node/$(arg block_2)/pose $(arg block_2)/pose" />
  <node pkg="topic_tools" type="relay" name="block3_pose_relay" args="/vrpn_client_node/$(arg block_3)/pose $(arg block_3)/pose" />
  <node pkg="topic_tools" type="relay" name="block4_pose_relay" args="/vrpn_client_node/$(arg block_4)/pose $(arg block_4)/pose" /> -->
  <node pkg="mushr_mocap" type="block_pose.py" name="pose_offset_node" output="screen">
    <rosparam param="tracked_objects" subst_value="true">
      [$(arg ramp_1),
       $(arg ramp_2),
       $(arg block_1),
       $(arg block_2),
       $(arg block_3),
       $(arg block_4)]
    </rosparam>
  </node>

  <node pkg="mushr_mocap" type="relay_mocap.py" name="relay" args="$(arg asset_name) $(arg mocap_topic)" output="screen" />


  <group ns="$(arg mocap_topic)">
    <node pkg="mushr_mocap" type="car_odom_publisher.py" name="odom_publisher" output="screen">
      <!-- Pass the car pose topic to the velocity publisher -->
      <remap from="car_pose" to="$(arg pose_topic)" />
      <!-- Publish the filtered velocity on the specified topic -->
      <remap from="car_odom" to="$(arg odom_topic)" />
      <!-- Parameter to set the alpha value for the low-pass filter -->
      <param name="alpha" value="$(arg filter_alpha)" />
    </node>
  </group>
</launch>
